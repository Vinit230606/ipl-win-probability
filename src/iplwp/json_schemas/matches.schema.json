{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "docs/data/matches.json: index of test-season chases",
  "type": "object",
  "required": ["generated_at", "best_model", "other_model", "featured_match_id", "matches"],
  "additionalProperties": false,
  "properties": {
    "generated_at": {"type": "string"},
    "best_model": {"enum": ["gbm", "lr_full"]},
    "other_model": {"enum": ["gbm", "lr_full"]},
    "featured_match_id": {"type": "string"},
    "matches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["match_id", "season", "date", "venue", "batting_team", "bowling_team",
                     "target", "chase_won", "result_text", "swing", "brier_baseline",
                     "brier_model", "brier_other"],
        "properties": {
          "match_id": {"type": "string", "minLength": 1},
          "season": {"type": "integer"},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "venue": {"type": ["string", "null"]},
          "batting_team": {"type": "string"},
          "bowling_team": {"type": "string"},
          "target": {"type": "integer", "minimum": 1},
          "chase_won": {"enum": [0, 1]},
          "result_text": {"type": "string"},
          "swing": {"$ref": "#/$defs/prob"},
          "brier_baseline": {"$ref": "#/$defs/prob"},
          "brier_model": {"$ref": "#/$defs/prob"},
          "brier_other": {"$ref": "#/$defs/prob"}
        }
      }
    }
  },
  "$defs": {"prob": {"type": "number", "minimum": 0, "maximum": 1}}
}
