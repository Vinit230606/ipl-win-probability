{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "docs/data/edge_cases.json: the edge-case analysis shown on edge-cases.html",
  "type": "object",
  "required": ["chosen", "validation", "tuning", "post_test", "scenarios", "monotonicity", "coverage",
               "reach", "display_floor", "fit", "lr_core_test"],
  "properties": {
    "chosen": {"type": "object", "required": ["shrinkage", "k", "support_bucket", "platt_slope", "platt_intercept"]},
    "validation": {"type": "object", "required": ["val_log_loss", "val_brier", "val_log_loss_lr_core", "val_brier_lr_core"]},
    "tuning": {"type": "array", "minItems": 1},
    "scenarios": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["runs_needed", "balls_left", "wickets_left", "why", "support_chases", "lr_weight",
                   "p_lr_core", "p_simulation", "p_calculator"],
      "properties": {
        "p_lr_core": {"type": "number", "minimum": 0, "maximum": 1},
        "p_simulation": {"type": "number", "minimum": 0, "maximum": 1},
        "p_calculator": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "monotonicity": {"type": "object", "required": ["lr_core", "simulation", "blend_before_envelope", "calculator"]},
    "coverage": {"type": "object", "required": ["calculator_states", "states_without_data", "lr_core_near_certain_without_data"]},
    "reach": {"type": "array", "minItems": 1},
    "post_test": {"type": "object", "required": ["all_rows", "rows_without_data", "near_certain_wrong"]}
  }
}
