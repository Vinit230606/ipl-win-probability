{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "docs/data/matches/<match_id>.json: ball-by-ball replay of one chase",
  "type": "object",
  "additionalProperties": false,
  "required": ["match_id", "season", "date", "venue", "batting_team", "bowling_team", "target",
               "chase_won", "result_text", "best_model", "other_model", "summary", "start",
               "big_overs", "balls"],
  "properties": {
    "match_id": {"type": "string"},
    "season": {"type": "integer"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "venue": {"type": ["string", "null"]},
    "batting_team": {"type": "string"},
    "bowling_team": {"type": "string"},
    "target": {"type": "integer", "minimum": 1},
    "chase_won": {"enum": [0, 1]},
    "result_text": {"type": "string"},
    "best_model": {"enum": ["gbm", "lr_full"]},
    "other_model": {"enum": ["gbm", "lr_full"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brier_baseline", "brier_model", "brier_other", "model_closer_share"],
      "properties": {
        "brier_baseline": {"$ref": "#/$defs/prob"},
        "brier_model": {"$ref": "#/$defs/prob"},
        "brier_other": {"$ref": "#/$defs/prob"},
        "model_closer_share": {"$ref": "#/$defs/prob"}
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p_base", "p_model", "p_other"],
      "properties": {
        "p_base": {"$ref": "#/$defs/prob"},
        "p_model": {"$ref": "#/$defs/prob"},
        "p_other": {"$ref": "#/$defs/prob"}
      }
    },
    "big_overs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["over", "runs", "i_from", "i_to"],
        "properties": {
          "over": {"type": "integer", "minimum": 1, "maximum": 20},
          "runs": {"type": "integer", "minimum": 0},
          "i_from": {"type": "integer", "minimum": 1},
          "i_to": {"type": "integer", "minimum": 1}
        }
      }
    },
    "balls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["i", "label", "event", "score", "runs_needed", "balls_left", "wickets_left",
                     "rrr", "r18", "w18", "phase", "wicket", "terminal", "p_base", "p_model",
                     "p_other"],
        "properties": {
          "i": {"type": "integer", "minimum": 1},
          "label": {"type": "string", "pattern": "^\\d{1,2}\\.[1-6]$"},
          "event": {"type": "string", "minLength": 1},
          "score": {"type": "string", "pattern": "^\\d+/\\d+$"},
          "runs_needed": {"type": "integer", "minimum": 0},
          "balls_left": {"type": "integer", "minimum": 0, "maximum": 120},
          "wickets_left": {"type": "integer", "minimum": 0, "maximum": 10},
          "rrr": {"type": "number", "minimum": 0},
          "r18": {"type": "integer", "minimum": 0},
          "w18": {"type": "integer", "minimum": 0},
          "phase": {"enum": ["powerplay", "middle", "death"]},
          "wicket": {"type": "boolean"},
          "terminal": {"type": "boolean"},
          "p_base": {"$ref": "#/$defs/prob"},
          "p_model": {"$ref": "#/$defs/prob"},
          "p_other": {"$ref": "#/$defs/prob"}
        }
      }
    }
  },
  "$defs": {"prob": {"type": "number", "minimum": 0, "maximum": 1}}
}
